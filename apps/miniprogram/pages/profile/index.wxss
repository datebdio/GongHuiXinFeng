.profile-page{min-height:100vh;background:var(--gx-bg);padding-bottom:48rpx;}.profile-hero{padding:30rpx 32rpx 80rpx;background:linear-gradient(145deg,#2b3036,#454b53);color:#fff;}.profile-top{display:flex;align-items:center;}.avatar-large{width:106rpx;height:106rpx;border-radius:34rpx;background:linear-gradient(145deg,#f5b15a,#d92b2b);display:flex;align-items:center;justify-content:center;font-size:44rpx;font-weight:900;box-shadow:0 16rpx 34rpx rgba(0,0,0,.18);}.profile-copy{margin-left:20rpx;}.profile-name{font-size:34rpx;font-weight:850;}.profile-no{margin-top:5rpx;font-size:20rpx;opacity:.58;}.profile-tags{display:flex;gap:9rpx;margin-top:12rpx;}.profile-tag{padding:6rpx 12rpx;border-radius:999rpx;background:rgba(255,255,255,.1);font-size:18rpx;}.profile-tag.auth{color:#ffd178;}.profile-arrow{font-size:46rpx;opacity:.45;}.level-panel{margin-top:34rpx;padding-top:28rpx;border-top:1rpx solid rgba(255,255,255,.1);display:flex;align-items:center;justify-content:space-between;}.level-kicker{font-size:19rpx;opacity:.55;}.level-name{margin-top:5rpx;font-size:34rpx;font-weight:850;color:#ffd17b;}.level-progress-text{margin-top:8rpx;font-size:20rpx;opacity:.57;}.level-badge{width:86rpx;height:86rpx;border-radius:26rpx;background:linear-gradient(145deg,#ffd579,#e89a35);color:#794604;display:flex;align-items:center;justify-content:center;font-size:38rpx;font-weight:900;transform:rotate(5deg);}.assets-card{position:relative;margin:-42rpx 28rpx 0;display:grid;grid-template-columns:1fr 1rpx 1fr 1rpx 1fr;padding:28rpx 12rpx;}.asset-item{text-align:center;}.asset-value{font-size:32rpx;font-weight:850;}.asset-value.gold{color:#b66a13;}.asset-value.red{color:var(--gx-brand);}.asset-label{margin-top:7rpx;color:var(--gx-text-3);font-size:19rpx;}.asset-divider{background:var(--gx-line);height:66rpx;align-self:center;}.menu-card{margin:20rpx 28rpx 0;padding:4rpx 24rpx;}.menu-row{display:flex;align-items:center;padding:21rpx 0;border-bottom:1rpx solid var(--gx-line);}.menu-row:last-child{border-bottom:0;}.menu-icon{width:58rpx;height:58rpx;border-radius:18rpx;background:#f3f4f6;color:#59616a;display:flex;align-items:center;justify-content:center;font-weight:800;margin-right:16rpx;}.menu-title{font-size:24rpx;font-weight:720;}.menu-subtitle{margin-top:4rpx;color:var(--gx-text-3);font-size:18rpx;}.menu-arrow{font-size:38rpx;color:#c3c7cc;}.profile-debug{margin:22rpx 28rpx 0;}.debug-actions{display:flex;gap:12rpx;}.debug-auth{padding:11rpx 24rpx;border-radius:999rpx;background:#eef0f2;color:#737b84;font-size:21rpx;}.debug-auth.active{background:#20242b;color:#fff;}.debug-copy{margin-top:14rpx;color:var(--gx-text-3);font-size:19rpx;line-height:1.6;}
