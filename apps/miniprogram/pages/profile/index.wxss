.profile-page{min-height:100vh;background:#f6f7fb;padding-bottom:48rpx}.profile-hero{padding:36rpx 32rpx 70rpx;background:linear-gradient(150deg,#d71920,#a80f16);color:#fff}.profile-top{display:flex;align-items:center}.avatar-large{width:112rpx;height:112rpx;border-radius:50%;background:#fff;color:#d71920;display:flex;align-items:center;justify-content:center;font-size:46rpx;font-weight:900}.profile-copy{margin-left:22rpx}.profile-name{font-size:36rpx;font-weight:800}.profile-no{margin-top:8rpx;font-size:22rpx;opacity:.75}.profile-tags{display:flex;gap:10rpx;margin-top:14rpx}.profile-tag{padding:6rpx 16rpx;border-radius:999rpx;background:rgba(255,255,255,.18);font-size:20rpx}.profile-tag.auth{color:#ffd76a}.profile-arrow{font-size:44rpx;opacity:.5}.level-panel{margin-top:36rpx;padding:26rpx;background:rgba(255,255,255,.12);border-radius:28rpx;display:flex;justify-content:space-between;align-items:center}.level-kicker{font-size:20rpx;opacity:.7}.level-name{font-size:36rpx;font-weight:900;margin-top:8rpx}.level-progress-text{font-size:20rpx;margin-top:8rpx;opacity:.75}.level-badge{width:86rpx;height:86rpx;border-radius:50%;background:#ffd76a;color:#9b5500;display:flex;align-items:center;justify-content:center;font-size:38rpx;font-weight:900}.assets-card{margin:-35rpx 28rpx 0;background:#fff;border-radius:28rpx;padding:30rpx 10rpx;display:grid;grid-template-columns:1fr 1rpx 1fr 1rpx 1fr;box-shadow:0 10rpx 30rpx rgba(0,0,0,.06)}.asset-item{text-align:center}.asset-value{font-size:34rpx;font-weight:900}.asset-value.gold{color:#e39a16}.asset-value.red{color:#d71920}.asset-label{font-size:20rpx;color:#8b929c;margin-top:8rpx}.asset-divider{height:70rpx;background:#eee}.menu-card{margin:24rpx 28rpx;background:#fff;border-radius:28rpx;padding:0 26rpx}.menu-row{display:flex;align-items:center;padding:24rpx 0;border-bottom:1rpx solid #eee}.menu-row:last-child{border:0}.menu-icon{width:60rpx;height:60rpx;border-radius:18rpx;background:#f3f4f6;display:flex;align-items:center;justify-content:center;margin-right:18rpx}.menu-title{font-size:26rpx;font-weight:700}.menu-subtitle{font-size:20rpx;color:#8b929c;margin-top:5rpx}.menu-arrow{font-size:38rpx;color:#bbb}