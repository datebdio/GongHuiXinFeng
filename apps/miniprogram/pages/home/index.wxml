<view class="page-shell home-page-v2 safe-bottom" wx:if="{{user && grab}}">
  <view class="profile-header">
    <view class="avatar-v2">锋</view>
    <view class="profile-main">
      <view class="profile-name">{{user.nickname}}</view>
      <view class="profile-meta">{{user.level}} · {{user.authStatus === 'VERIFIED' ? '已认证' : '审核中'}}</view>
    </view>
    <view class="asset-box">
      <view class="asset-label">新锋币</view>
      <view class="asset-value">{{user.coins}}</view>
    </view>
  </view>

  <view class="income-card">
    <view class="income-title">今日服务收益</view>
    <view class="income-value">¥{{user.todayIncome || '12.8'}}</view>
    <view class="income-tip">完成任务，获得更多奖励</view>
  </view>

  <view class="task-card {{stateMeta.tone}}">
    <view class="task-head">
      <view>
        <view class="task-title">今日工会任务</view>
        <view class="task-time">{{grab.slot}}</view>
      </view>
      <view class="state-badge">{{stateMeta.label}}</view>
    </view>
    <view class="task-info">
      <view><text class="big-number">{{grab.remainingSeats}}</text><text class="small-text">/{{grab.totalSeats}} 名额</text></view>
      <view class="count-text">{{grab.state === 'WAITING' ? countdownText : '立即参与'}}</view>
    </view>
    <t-button theme="primary" block size="large" disabled="{{grab.state !== 'OPEN' && grab.state !== 'CLAIMED'}}" bind:tap="grabNow">{{stateMeta.action}}</t-button>
  </view>

  <view class="quick-grid">
    <view class="quick-item" bind:tap="openLearn">每日学习</view>
    <view class="quick-item">成长等级</view>
    <view class="quick-item" bind:tap="openShop">福利商城</view>
  </view>

  <view class="section-title">暖新资讯</view>
  <view class="content-card" bind:tap="openLearn">
    <view class="content-tag">工会权益</view>
    <view class="content-title">跑在城市里，也要知道这些“新”权益</view>
    <view class="content-reward">学习完成可获得金币奖励</view>
  </view>

  <view class="section-title">今日榜单</view>
  <view class="rank-card card">
    <view class="rank-row" wx:for="{{ranking}}" wx:key="rank">
      <view class="rank-no">{{item.rank}}</view>
      <view class="flex-1">{{item.name}}</view>
      <view>{{item.score}}</view>
    </view>
  </view>
</view>
