.home-page-v2 { padding-top: 24rpx; }
.profile-header { display:flex; align-items:center; padding:0 8rpx 24rpx; }
.avatar-v2 { width:84rpx;height:84rpx;border-radius:50%;background:#D71920;color:#fff;display:flex;align-items:center;justify-content:center;font-size:34rpx;font-weight:800; }
.profile-main { flex:1;margin-left:20rpx; }
.profile-name { font-size:32rpx;font-weight:800;color:#1f2329; }
.profile-meta { margin-top:8rpx;font-size:22rpx;color:#86909c; }
.asset-box { background:#fff7e8;padding:14rpx 22rpx;border-radius:20rpx;text-align:center; }
.asset-label { font-size:20rpx;color:#8c6b32; }
.asset-value { font-size:38rpx;font-weight:900;color:#d88b00; }
.income-card { margin:0 0 24rpx;padding:34rpx;border-radius:28rpx;background:#fff;box-shadow:0 10rpx 30rpx rgba(0,0,0,.05); }
.income-title { color:#86909c;font-size:22rpx; }
.income-value { margin-top:12rpx;font-size:68rpx;font-weight:900;color:#1f2329; }
.income-tip { margin-top:8rpx;color:#86909c;font-size:22rpx; }
.task-card { padding:32rpx;border-radius:30rpx;background:linear-gradient(135deg,#D71920,#F28A00);color:#fff;box-shadow:0 16rpx 36rpx rgba(215,25,32,.18); }
.task-head {display:flex;justify-content:space-between;align-items:flex-start;}
.task-title {font-size:30rpx;font-weight:800;}
.task-time {margin-top:8rpx;font-size:22rpx;opacity:.85;}
.state-badge {padding:8rpx 18rpx;border-radius:999rpx;background:rgba(255,255,255,.18);font-size:20rpx;}
.task-info {display:flex;justify-content:space-between;align-items:end;margin:36rpx 0;}
.big-number {font-size:72rpx;font-weight:900;}.small-text {font-size:24rpx;}.count-text {font-size:26rpx;font-weight:700;}
.quick-grid {display:flex;gap:16rpx;margin:24rpx 0;}
.quick-item {flex:1;background:#fff;border-radius:22rpx;padding:28rpx 10rpx;text-align:center;font-size:25rpx;font-weight:700;box-shadow:0 8rpx 24rpx rgba(0,0,0,.04);}
.section-title {margin:28rpx 0 16rpx;font-size:30rpx;font-weight:800;color:#1f2329;}
.content-card {background:#fff;border-radius:24rpx;padding:28rpx;box-shadow:0 8rpx 24rpx rgba(0,0,0,.04);}
.content-tag {color:#D71920;font-size:21rpx;}.content-title{margin-top:12rpx;font-size:28rpx;font-weight:700;line-height:1.5;}.content-reward{margin-top:12rpx;color:#86909c;font-size:22rpx;}
.rank-card {background:#fff;border-radius:24rpx;padding:0 24rpx;}
.rank-row {display:flex;padding:22rpx 0;border-bottom:1rpx solid #f2f3f5;font-size:25rpx;}
.rank-no {width:48rpx;color:#D71920;font-weight:800;}
