.result-page{min-height:100vh;background:var(--gx-bg);}.result-hero{padding:70rpx 40rpx 90rpx;text-align:center;color:#fff;background:linear-gradient(145deg,#176f5e,#23987b 56%,#e0a13d);}.result-hero.failed{background:linear-gradient(145deg,#59616b,#777e87);}.result-icon{width:108rpx;height:108rpx;margin:0 auto;border-radius:50%;background:#fff;color:#1b8e70;display:flex;align-items:center;justify-content:center;font-size:52rpx;font-weight:900;box-shadow:0 18rpx 40rpx rgba(0,0,0,.12);}.failed .result-icon{color:#737a84;}.result-kicker{margin-top:28rpx;font-size:22rpx;opacity:.76;}.result-title{margin-top:8rpx;font-size:40rpx;font-weight:850;}.score-line{margin-top:18rpx;font-size:23rpx;opacity:.82;}.score-line text{font-size:34rpx;font-weight:850;}.result-body{position:relative;margin-top:-38rpx;padding:0 28rpx 48rpx;}.reward-card{padding:30rpx;}.reward-head{display:flex;align-items:center;justify-content:space-between;}.reward-kicker{color:var(--gx-brand);font-size:20rpx;}.reward-title{margin-top:7rpx;font-size:30rpx;font-weight:800;}.reward-seal{width:70rpx;height:70rpx;border-radius:22rpx;background:#fff0e4;color:#bc6717;display:flex;align-items:center;justify-content:center;font-size:30rpx;font-weight:900;transform:rotate(6deg);}.reward-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:28rpx;}.reward-item{display:flex;align-items:center;padding:22rpx 18rpx;border-radius:20rpx;background:#f8f9fa;}.reward-symbol{width:60rpx;height:60rpx;border-radius:18rpx;display:flex;align-items:center;justify-content:center;margin-right:14rpx;font-weight:900;}.coin-symbol{background:#fff1d4;color:#b56b13;}.red-symbol{background:#ffecee;color:#c92f38;}.reward-value{font-size:30rpx;font-weight:850;}.reward-tip{margin-top:20rpx;padding:18rpx 20rpx;border-radius:16rpx;background:#fff8ed;color:#9d6b2f;font-size:21rpx;line-height:1.6;}.result-summary{padding:34rpx;}.summary-title{font-size:30rpx;font-weight:800;}.summary-desc{margin-top:12rpx;line-height:1.7;}.result-rule{text-align:center;margin-top:20rpx;color:var(--gx-text-3);font-size:20rpx;}
