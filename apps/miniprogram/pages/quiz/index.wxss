.quiz-page{padding-top:28rpx;}.quiz-kicker{font-size:21rpx;color:var(--gx-text-3);}.quiz-progress{margin-top:6rpx;font-size:30rpx;font-weight:800;}.quiz-progress text{color:var(--gx-brand);font-size:38rpx;}.quiz-timer{text-align:right;padding:10rpx 18rpx;border-radius:18rpx;background:#fff4e8;}.timer-label{font-size:18rpx;color:#a77239;}.timer-value{margin-top:2rpx;font-weight:850;color:#b76614;font-size:28rpx;}.step-track{height:10rpx;margin:24rpx 0 30rpx;border-radius:999rpx;background:#e9ebee;overflow:hidden;}.step-fill{height:100%;background:linear-gradient(90deg,var(--gx-brand),var(--gx-orange));border-radius:999rpx;transition:width .2s;}.question-card{padding:34rpx 30rpx;}.question-no{color:var(--gx-brand);font-weight:850;font-size:22rpx;}.question-title{margin-top:12rpx;font-size:34rpx;font-weight:800;line-height:1.55;}.option-list{margin-top:30rpx;}.option{display:flex;align-items:center;min-height:96rpx;margin-top:16rpx;padding:18rpx 20rpx;border-radius:20rpx;border:2rpx solid #eff0f2;background:#fafbfc;box-sizing:border-box;}.option.selected{border-color:#e85252;background:#fff5f5;}.option-letter{width:52rpx;height:52rpx;border-radius:16rpx;background:#eef0f2;color:#6d747d;display:flex;align-items:center;justify-content:center;font-weight:800;}.selected .option-letter{background:var(--gx-brand);color:#fff;}.option-text{margin-left:18rpx;font-size:25rpx;line-height:1.5;}.option-check{width:34rpx;color:var(--gx-brand);font-weight:800;text-align:right;}.quiz-note{text-align:center;margin-top:24rpx;color:var(--gx-text-3);font-size:20rpx;}
