.auth-page { padding-top: 20rpx; }
.auth-intro { display: flex; align-items: flex-start; background: linear-gradient(135deg, #fff 0%, #fff7f3 100%); border: 1rpx solid #ffebe6; }
.intro-step { width: 74rpx; height: 74rpx; flex: 0 0 auto; margin-right: 20rpx; border-radius: 22rpx; background: var(--gx-brand); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 28rpx; }
.intro-title { font-size: 30rpx; font-weight: 800; }
.intro-desc { margin-top: 10rpx; color: var(--gx-text-2); font-size: 23rpx; line-height: 1.6; }
.identity-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }
.identity-card { position: relative; min-height: 190rpx; padding: 28rpx; border-radius: 24rpx; background: #fff; border: 2rpx solid transparent; box-sizing: border-box; }
.identity-card.active { border-color: var(--gx-brand); background: #fffafa; }
.identity-icon { width: 76rpx; height: 76rpx; border-radius: 22rpx; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 30rpx; }
.identity-icon.delivery { background: #fff0e4; color: #e77b1d; }
.identity-icon.express { background: #edf4ff; color: #3979cf; }
.identity-name { margin-top: 18rpx; font-size: 28rpx; font-weight: 700; }
.identity-check { position: absolute; right: 20rpx; top: 20rpx; width: 34rpx; height: 34rpx; border-radius: 50%; color: #fff; background: var(--gx-brand); display: flex; align-items: center; justify-content: center; font-size: 20rpx; }
.identity-card:not(.active) .identity-check { background: #eef0f2; }
.proof-card { padding: 10rpx 28rpx 28rpx; }
.proof-item { display: flex; align-items: center; padding: 24rpx 0; }
.radio { width: 34rpx; height: 34rpx; border-radius: 50%; border: 2rpx solid #c9cdd3; box-sizing: border-box; display: flex; align-items: center; justify-content: center; margin-right: 18rpx; }
.proof-item.active .radio { border-color: var(--gx-brand); }
.radio-dot { width: 18rpx; height: 18rpx; border-radius: 50%; background: transparent; }
.proof-item.active .radio-dot { background: var(--gx-brand); }
.proof-title { font-weight: 650; font-size: 26rpx; margin-bottom: 4rpx; }
.upload-zone { margin-top: 16rpx; padding: 34rpx 20rpx; border: 2rpx dashed #d9dde2; border-radius: 22rpx; text-align: center; background: #fafbfc; }
.upload-zone.uploaded { border-color: #9dd8c2; background: #f3fbf8; }
.upload-mark { width: 66rpx; height: 66rpx; margin: 0 auto 14rpx; border-radius: 20rpx; display: flex; align-items: center; justify-content: center; background: #f0f1f3; color: var(--gx-text-2); font-size: 40rpx; }
.uploaded .upload-mark { color: #fff; background: var(--gx-success); }
.upload-title { font-size: 25rpx; font-weight: 650; margin-bottom: 8rpx; }
.privacy-tip { margin: 22rpx 8rpx 0; color: var(--gx-text-3); font-size: 21rpx; line-height: 1.6; }
