.shop-page{min-height:100vh;background:var(--gx-bg);padding-bottom:48rpx;}.shop-hero{margin:0 28rpx;padding:34rpx;border-radius:0 0 32rpx 32rpx;background:linear-gradient(145deg,#2d3138,#454b54);color:#fff;display:flex;align-items:center;justify-content:space-between;overflow:hidden;position:relative;}.shop-hero::after{content:'';position:absolute;width:260rpx;height:260rpx;border-radius:50%;right:-90rpx;top:-80rpx;background:rgba(255,255,255,.06);}.shop-kicker{color:#ffc56f;font-size:20rpx;}.shop-title{margin-top:12rpx;font-size:35rpx;font-weight:850;line-height:1.45;}.coin-balance{display:inline-flex;margin-top:22rpx;padding:10rpx 16rpx;border-radius:999rpx;background:rgba(255,255,255,.1);font-size:20rpx;}.coin-balance text{color:#ffd175;font-size:28rpx;font-weight:850;margin-right:8rpx;}.hero-gift{position:relative;z-index:2;width:130rpx;height:130rpx;margin-right:4rpx;transform:rotate(6deg);}.gift-top{position:absolute;left:10rpx;right:10rpx;top:14rpx;height:28rpx;border-radius:12rpx;background:#ffd37b;}.gift-body{position:absolute;left:18rpx;right:18rpx;top:42rpx;bottom:8rpx;border-radius:14rpx;background:linear-gradient(145deg,#ffc95c,#e9922c);display:flex;align-items:center;justify-content:center;color:#805007;font-size:40rpx;font-weight:900;box-shadow:0 14rpx 28rpx rgba(0,0,0,.18);}.auth-banner{margin:20rpx 28rpx 0;padding:20rpx 22rpx;border-radius:20rpx;background:#fff6e9;border:1rpx solid #ffe4bd;display:flex;align-items:center;}.auth-banner.verified{background:#effaf5;border-color:#cbeadd;}.auth-mark{width:54rpx;height:54rpx;border-radius:16rpx;background:#fff;color:#bb711f;display:flex;align-items:center;justify-content:center;font-weight:850;margin-right:16rpx;}.verified .auth-mark{color:var(--gx-success);}.auth-title{font-size:23rpx;font-weight:700;}.auth-desc{margin-top:4rpx;color:var(--gx-text-3);font-size:19rpx;}.category-scroll{margin-top:26rpx;white-space:nowrap;}.category-row{display:flex;padding:0 28rpx 8rpx;gap:12rpx;}.category-pill{flex:0 0 auto;padding:12rpx 22rpx;border-radius:999rpx;background:#fff;color:#737a84;font-size:22rpx;}.category-pill.active{background:var(--gx-brand);color:#fff;}.product-grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx;padding:12rpx 28rpx 0;}.product-card{overflow:hidden;border-radius:24rpx;background:#fff;box-shadow:var(--gx-shadow);}.product-visual{position:relative;height:220rpx;display:flex;align-items:center;justify-content:center;background:#f5f5f5;}.product-visual.meal{background:linear-gradient(145deg,#fff3df,#ffd9a8);}.product-visual.ride{background:linear-gradient(145deg,#edf4ff,#cadbf5);}.product-visual.data{background:linear-gradient(145deg,#f3efff,#dcd1ff);}.product-visual.service{background:linear-gradient(145deg,#edf9f4,#cdebdc);}.product-visual.power{background:linear-gradient(145deg,#eef0f3,#d0d5dc);}.product-icon-text{width:100rpx;height:100rpx;border-radius:30rpx;background:rgba(255,255,255,.78);display:flex;align-items:center;justify-content:center;font-size:48rpx;font-weight:900;color:#4a5058;box-shadow:0 14rpx 28rpx rgba(63,55,42,.08);}.stock-chip{position:absolute;right:12rpx;top:12rpx;padding:6rpx 10rpx;border-radius:999rpx;background:rgba(31,35,41,.52);color:#fff;font-size:17rpx;}.product-body{padding:20rpx;}.product-category{color:var(--gx-text-3);font-size:18rpx;}.product-name{margin-top:7rpx;min-height:72rpx;font-size:25rpx;font-weight:750;line-height:1.4;}.product-price{margin-top:14rpx;color:#9a641d;font-size:19rpx;}.product-price>text:first-child{font-size:32rpx;font-weight:900;color:#b96c12;}.product-price .cash{font-size:20rpx;font-weight:650;color:var(--gx-brand);}.shop-rule{margin:24rpx 28rpx 0;}.rule-title{font-size:27rpx;font-weight:800;margin-bottom:12rpx;}.rule-line{padding:12rpx 0;color:var(--gx-text-2);font-size:22rpx;line-height:1.5;}.rule-line text{display:inline-flex;width:42rpx;height:42rpx;border-radius:12rpx;background:#f1f2f4;align-items:center;justify-content:center;margin-right:12rpx;color:#7c838c;font-size:16rpx;font-weight:800;}
