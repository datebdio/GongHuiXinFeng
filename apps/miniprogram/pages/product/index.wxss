.product-page{min-height:100vh;background:var(--gx-bg);}.detail-visual{position:relative;height:500rpx;display:flex;align-items:center;justify-content:center;overflow:hidden;}.detail-visual::before{content:'';position:absolute;width:420rpx;height:420rpx;border-radius:50%;background:rgba(255,255,255,.35);}.detail-visual.meal{background:linear-gradient(145deg,#fff1da,#ffc77f);}.detail-visual.ride{background:linear-gradient(145deg,#edf4ff,#bcd1f0);}.detail-visual.data{background:linear-gradient(145deg,#f1edff,#cfc2ff);}.detail-visual.service{background:linear-gradient(145deg,#eaf8f1,#bfe4d3);}.detail-visual.power{background:linear-gradient(145deg,#eef0f3,#c7ccd3);}.detail-icon{position:relative;z-index:2;width:170rpx;height:170rpx;border-radius:48rpx;background:rgba(255,255,255,.82);display:flex;align-items:center;justify-content:center;font-size:76rpx;font-weight:900;color:#434950;box-shadow:0 26rpx 50rpx rgba(75,62,45,.12);}.visual-label{position:absolute;left:30rpx;top:30rpx;padding:9rpx 16rpx;border-radius:999rpx;background:rgba(255,255,255,.72);font-size:20rpx;color:#555c65;}.visual-stock{position:absolute;right:30rpx;top:30rpx;padding:9rpx 16rpx;border-radius:999rpx;background:rgba(31,35,41,.5);color:#fff;font-size:20rpx;}.detail-body{position:relative;margin-top:-34rpx;padding:0 28rpx 50rpx;}.detail-main{padding:32rpx;}.detail-title{font-size:36rpx;font-weight:850;}.detail-summary{margin-top:14rpx;color:var(--gx-text-2);font-size:24rpx;line-height:1.65;}.price-line{display:flex;align-items:flex-end;justify-content:space-between;margin-top:28rpx;padding-top:22rpx;border-top:1rpx solid var(--gx-line);}.price-number{font-size:46rpx;font-weight:900;color:#b76b14;}.price-unit{font-size:22rpx;color:#9c6b32;}.cash-price{color:var(--gx-brand);font-size:25rpx;font-weight:750;}.price-type{padding:8rpx 14rpx;border-radius:999rpx;background:#f2f3f5;color:#777e87;font-size:19rpx;}.rule-card{margin-top:20rpx;}.rule-title{font-size:28rpx;font-weight:800;}.rule-text{margin-top:12rpx;color:var(--gx-text-2);font-size:23rpx;line-height:1.65;}.rule-item{display:flex;align-items:center;margin-top:16rpx;color:#68707a;font-size:22rpx;}.rule-dot{width:10rpx;height:10rpx;border-radius:50%;background:var(--gx-brand);margin-right:14rpx;}.auth-lock{display:flex;align-items:center;margin-top:20rpx;padding:20rpx 22rpx;border-radius:20rpx;background:#fff6e9;border:1rpx solid #ffe4bd;}.lock-mark{width:54rpx;height:54rpx;border-radius:16rpx;background:#fff;color:#b76c18;display:flex;align-items:center;justify-content:center;font-weight:850;margin-right:16rpx;}.lock-title{font-size:23rpx;font-weight:750;margin-bottom:4rpx;}.balance-note{text-align:center;margin-top:16rpx;color:var(--gx-text-3);font-size:20rpx;}
