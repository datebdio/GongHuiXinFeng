.login-page{min-height:100vh;background:#f6f7fb}.login-hero{padding:90rpx 48rpx 70rpx;background:linear-gradient(160deg,#d71920,#ed5a32);color:#fff;border-radius:0 0 56rpx 56rpx}.brand-badge{display:inline-flex;padding:10rpx 18rpx;border-radius:999rpx;background:rgba(255,255,255,.16);font-size:22rpx}.brand-title{margin-top:34rpx;font-size:72rpx;font-weight:900;letter-spacing:4rpx}.brand-subtitle{margin-top:18rpx;font-size:28rpx;line-height:1.7;opacity:.9}.hero-visual{height:280rpx;margin-top:40rpx;position:relative}.city{position:absolute;background:rgba(255,255,255,.15);bottom:20rpx;border-radius:18rpx 18rpx 0 0}.city-a{width:130rpx;height:120rpx}.city-b{left:110rpx;width:100rpx;height:180rpx}.city-c{right:20rpx;width:150rpx;height:90rpx}.road{position:absolute;bottom:0;left:-60rpx;right:-60rpx;height:40rpx;background:rgba(0,0,0,.15)}.rider-card{position:absolute;top:20rpx;left:40rpx;width:430rpx;padding:22rpx;background:#fff;border-radius:28rpx;color:#222;display:flex;align-items:center;box-shadow:0 18rpx 45rpx rgba(0,0,0,.15)}.rider-mark{width:80rpx;height:80rpx;border-radius:24rpx;background:#fff0ef;color:#d71920;display:flex;align-items:center;justify-content:center;font-size:38rpx;font-weight:900}.rider-copy{margin-left:18rpx}.rider-title{font-size:30rpx;font-weight:800}.rider-sub{font-size:22rpx;color:#888;margin-top:8rpx}.coin{display:none}.login-panel{margin:-20rpx 24rpx 0;background:#fff;border-radius:32rpx;padding:44rpx 32rpx;position:relative}.panel-title{font-size:38rpx;font-weight:900}.panel-desc{margin-top:14rpx;font-size:25rpx;line-height:1.6;color:#666}.agreement{margin-top:28rpx;display:flex}.check{width:34rpx;height:34rpx;border:2rpx solid #ddd;border-radius:8rpx}.check.checked{background:#d71920;border-color:#d71920}.agreement-text{margin-left:14rpx;font-size:22rpx;color:#888}.agreement-text text{color:#d71920}.prototype-note{margin-top:20rpx;text-align:center;color:#aaa;font-size:20rpx}