.learn-page{padding-top:20rpx;}.task-status{display:flex;align-items:center;padding:20rpx 24rpx;margin-bottom:20rpx;border-radius:20rpx;background:#fff5e9;border:1rpx solid #ffe4c0;}.task-dot{width:16rpx;height:16rpx;border-radius:50%;background:var(--gx-warning);box-shadow:0 0 0 8rpx rgba(229,139,36,.12);margin-right:18rpx;}.task-title{font-weight:700;font-size:24rpx;margin-bottom:4rpx;}.task-clock{font-size:34rpx;font-weight:850;color:#b76510;}
.media-card{position:relative;height:390rpx;overflow:hidden;border-radius:30rpx;padding:28rpx;background:linear-gradient(145deg,#26343f,#3e5260 52%,#8d5a3e);color:#fff;box-shadow:0 20rpx 50rpx rgba(30,42,52,.18);}.media-card::after{content:'';position:absolute;width:360rpx;height:360rpx;border-radius:50%;background:rgba(255,255,255,.06);right:-120rpx;top:-130rpx;}.media-badge{position:relative;z-index:3;display:inline-flex;padding:8rpx 16rpx;border-radius:999rpx;background:rgba(255,255,255,.13);font-size:20rpx;}.media-center{position:absolute;z-index:4;left:0;right:0;top:115rpx;text-align:center;}.play-button{width:104rpx;height:104rpx;margin:0 auto;border-radius:50%;background:#fff;color:var(--gx-brand);display:flex;align-items:center;justify-content:center;font-size:42rpx;font-weight:800;box-shadow:0 16rpx 36rpx rgba(0,0,0,.18);}.media-action{margin-top:18rpx;font-size:24rpx;opacity:.86;}.media-city{position:absolute;bottom:0;background:rgba(255,255,255,.07);border-radius:12rpx 12rpx 0 0;}.city-left{left:30rpx;width:130rpx;height:110rpx;}.city-mid{left:140rpx;width:160rpx;height:150rpx;}.city-right{right:35rpx;width:150rpx;height:90rpx;}
.progress-card{margin-top:20rpx;}.progress-title{font-weight:700;}.progress-value{color:var(--gx-brand);font-weight:850;}.progress-track{margin-top:18rpx;height:14rpx;border-radius:999rpx;background:#f0f1f3;overflow:hidden;}.progress-fill{height:100%;border-radius:999rpx;background:linear-gradient(90deg,var(--gx-brand),var(--gx-orange));transition:width .2s;}.progress-note{margin-top:14rpx;color:var(--gx-text-3);font-size:20rpx;line-height:1.55;}
.content-card{margin-top:20rpx;}.content-kicker{color:var(--gx-brand);font-size:21rpx;font-weight:700;}.content-title{margin-top:8rpx;font-size:32rpx;line-height:1.5;font-weight:850;}.content-paragraph{margin-top:20rpx;color:var(--gx-text-2);line-height:1.75;font-size:25rpx;}.knowledge-list{margin-top:24rpx;padding-top:10rpx;border-top:1rpx solid var(--gx-line);}.knowledge-item{display:flex;align-items:flex-start;padding:18rpx 0;color:#4f5660;font-size:24rpx;line-height:1.6;}.knowledge-no{flex:0 0 auto;width:48rpx;height:48rpx;margin-right:16rpx;border-radius:14rpx;background:#fff0ef;color:var(--gx-brand);display:flex;align-items:center;justify-content:center;font-size:18rpx;font-weight:800;}.mock-finish{text-align:center;margin-top:20rpx;color:var(--gx-text-3);font-size:21rpx;text-decoration:underline;}
