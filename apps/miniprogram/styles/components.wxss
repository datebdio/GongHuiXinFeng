.page-shell {
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--gx-bg);
  color: var(--gx-text);
  padding: 24rpx 28rpx 48rpx;
}
.card {
  background: var(--gx-card);
  border-radius: var(--gx-radius);
  box-shadow: var(--gx-shadow);
  padding: 28rpx;
  box-sizing: border-box;
}
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 30rpx 2rpx 18rpx;
}
.section-title { font-size: 30rpx; font-weight: 700; color: var(--gx-text); }
.section-link { font-size: 24rpx; color: var(--gx-text-3); }
.muted { color: var(--gx-text-2); }
.caption { color: var(--gx-text-3); font-size: 22rpx; }
.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 46rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: #f3f4f6;
  color: var(--gx-text-2);
}
.pill.brand { background: var(--gx-brand-soft); color: var(--gx-brand); }
.pill.success { background: #ebf8f3; color: var(--gx-success); }
.pill.warning { background: #fff5e9; color: var(--gx-warning); }
.row { display: flex; align-items: center; }
.between { justify-content: space-between; }
.flex-1 { flex: 1; min-width: 0; }
.divider { height: 1rpx; background: var(--gx-line); }
.primary-button-wrap { margin-top: 28rpx; }
.debug-card {
  margin-top: 28rpx;
  padding: 22rpx;
  border: 1rpx dashed #d6d9de;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.72);
}
.debug-title { font-size: 22rpx; color: var(--gx-text-3); margin-bottom: 16rpx; }
.safe-bottom { padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); }
